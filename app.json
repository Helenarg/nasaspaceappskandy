{
  "expo": {
    "name": "nasaspaceapps.lk",
    "slug": "nasaspaceapps-lk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "NASA Space Apps Challenge Sri Lanka — Kandy",
      "shortName": "Space Apps LK",
      "description": "Sri Lanka's official NASA Space Apps Challenge hub. Kandy local event, October 3-5 2026, expanding to all 9 provinces.",
      "themeColor": "#050912",
      "backgroundColor": "#050912",
      "lang": "en"
    },
    "scheme": "nasaspaceapps",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ]
  }
}