{
  "expo": {
    "name": "nasaspaceapps.lk",
    "slug": "nasaspaceapps-lk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "NASA Space Apps Challenge Sri Lanka — Kandy",
      "shortName": "Space Apps LK",
      "description": "Explore NASA Space Apps from Kandy. Global event November 14–15, 2026; local arrangements to be confirmed.",
      "themeColor": "#07173F",
      "backgroundColor": "#07173F",
      "lang": "en"
    },
    "scheme": "nasaspaceapps",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-localization"
    ]
  }
}
