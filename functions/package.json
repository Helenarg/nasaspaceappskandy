{
  "name": "nasa-space-apps-kandy-backend",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions backend for NASA Space Apps Kandy website",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.6.0"
  },
  "private": true
}
